---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <h1 class="text-6xl font-bold text-gray-200 mb-4">404</h1>
    <h2 class="text-xl font-semibold text-gray-700 mb-2">页面不存在</h2>
    <p class="text-gray-500 mb-8">
      你访问的页面可能已被移除或地址有误。
    </p>
    <a
      href="/"
      class="inline-flex items-center px-4 py-2 rounded-lg bg-primary-600 text-white hover:bg-primary-700 transition-colors text-sm font-medium"
    >
      回到首页
    </a>
  </div>
</BaseLayout>
